{
  "name": "@fossity/probe-cli",
  "version": "0.1.0",
  "description": "Captures fingerprints and dependency data from your code, without shipping your code.",
  "license": "GPL-2.0-only",
  "author": "Fossity LLC (https://fossity.com)",
  "homepage": "https://www.fossity.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fossity/probe-cli.git"
  },
  "bugs": {
    "url": "https://github.com/fossity/probe-cli/issues"
  },
  "keywords": [
    "sca",
    "sbom",
    "open-source-audit",
    "fingerprint",
    "lockfile",
    "dependencies",
    "purl",
    "cli"
  ],
  "type": "commonjs",
  "bin": {
    "probe-cli": "dist/probe-cli.cjs"
  },
  "main": "dist/probe-cli.cjs",
  "files": [
    "dist/",
    "brand.config.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "release:npm": "node scripts/publish-npm.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "brand:check": "node scripts/brand-check.mjs",
    "brand:apply": "node scripts/brand-apply.mjs",
    "prepublishOnly": "npm run build && npm run brand:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run brand:check && npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "adm-zip": "^0.5.16",
    "commander": "^12.1.0",
    "fast-xml-parser": "^4.5.0",
    "isbinaryfile": "^4.0.10",
    "packageurl-js": "^1.2.1",
    "picocolors": "^1.1.1",
    "scanoss": "^0.17.3",
    "smol-toml": "^1.3.1",
    "uuid": "^9.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/node": "^20.17.0",
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
