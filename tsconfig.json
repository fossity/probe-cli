{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": false,
    "declaration": false,
    "sourceMap": true,
    "outDir": "build",
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "brand.config.json"]
}
